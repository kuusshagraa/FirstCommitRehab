PORT=3000
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=demo-rehab-ai

# Local development: start the Auth and Firestore emulators, then keep these enabled.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# For a real Firebase project, remove the emulator host values and point this at
# a service-account JSON file stored outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: HTTP endpoint implementing the joint-angle inference contract.
AI_EVALUATION_URL=
AI_SERVICE_TOKEN=
